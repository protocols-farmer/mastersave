  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --enable-source-maps dist/server.js",
    "start:local": "node --env-file=.env --enable-source-maps dist/server.js",
    "db:tables": "psql -U mastersave -d mastersave_db -h localhost -p 5432 -W -f ./migrations/1_creating_tables.sql",
    "db:tables:cloud": "dotenv run -f .env -- bash -c 'psql \"$DATABASE_URL\" -f ./migrations/1_creating_tables.sql'",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "busboy": "^1.6.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.5",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
