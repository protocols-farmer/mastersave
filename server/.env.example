# ---------- REQUIRED: the server exits at startup if any of these is missing ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

ACCESS_TOKEN_SECRET=PASTE_A_LONG_RANDOM_STRING
CLIENT_URL=http://localhost:8081

GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-or-FLWSECK-live-key
FLUTTERWAVE_WEBHOOK_HASH=PASTE_A_RANDOM_STRING_THAT_MATCHES_THE_DASHBOARD

# ---------- OPTIONAL: these defaults apply if you leave them out ----------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_MINUTES=10080
TRUSTED_PROXY_COUNT=1
WITHDRAWAL_COOLDOWN_MINUTES=1440
# GOOGLE_CLIENT_IDS=web-id,android-id,ios-id
# DEFAULT_AVATAR_URL=https://...
